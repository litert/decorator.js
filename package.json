{
  "name": "@litert/decorator-monorepo",
  "version": "0.3.0",
  "description": "The utility set of decorators.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "typings": "./lib/index.d.ts",
  "scripts": {
    "prepublishOnly": "npm run rebuild",
    "build": "./utils/build.sh",
    "build-watch": "./utils/build-watch.sh",
    "rebuild": "npm run clean && npm run lint && npm run build",
    "test": "npm run build && node --enable-source-maps --test --experimental-test-coverage packages/tests/*/app/*.test.js",
    "clean": "npx ottoia clean",
    "prepare": "utils/init.sh",
    "ottoia:prepublish": "npm run rebuild && npm run test",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litert/decorator.js.git"
  },
  "bugs": {
    "url": "https://github.com/litert/decorator.js/issues"
  },
  "type": "module",
  "homepage": "https://github.com/litert/decorator.js#readme",
  "keywords": [
    "litert",
    "lrt",
    "decorator"
  ],
  "author": "Angus.Fenying <i.am.x.fenying@gmail.com> (https://fenying.net)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@litert/eslint-plugin-rules": "^0.3.1",
    "@litert/ottoia": "^0.4.5",
    "@litert/utils-ts-types": "^2.4.0",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@litert/utils-object": "^2.4.0",
    "reflect-metadata": "^0.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "ottoia": {
    "releases": {
      "production": {
        "tag": "latest"
      }
    }
  },
  "private": true
}
